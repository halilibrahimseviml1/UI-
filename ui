splib._TranslationItems = splib._TranslationItems or {}
splib._TranslationIndex = splib._TranslationIndex or setmetatable({}, {__mode = "k"})

local function getTranslationMap()
    local map = rawget(_G, "SP_Hub_TKeys")
    if type(map) ~= "table" then
        map = {}
        rawset(_G, "SP_Hub_TKeys", map)
    end
    return map
end

local function rememberTranslationAlias(key, text)
    if key == nil or text == nil then return end
    local map = getTranslationMap()
    key = tostring(key)
    text = tostring(text)
    if key == "" or text == "" then return end
    map[key] = key
    map[text] = key
end

local function resolveTranslationKey(text)
    if text == nil then return nil end
    local map = getTranslationMap()
    return map[tostring(text)]
end

local function resolveTranslationKeyWithSuffix(text)
    if text == nil then return nil, "" end
    text = tostring(text)
    local exactKey = resolveTranslationKey(text)
    if exactKey then return exactKey, "" end
    local map = getTranslationMap()
    local bestKey, bestLen = nil, 0
    for alias, key in pairs(map) do
        if type(alias) == "string" and alias ~= "" and type(key) == "string" and text:sub(1, #alias) == alias then
            if #alias > bestLen then bestKey = key; bestLen = #alias end
        end
    end
    if bestKey then return bestKey, text:sub(bestLen + 1) end
    return nil, ""
end

local function getLiveTranslation(key)
    key = tostring(key or "")
    local translator = rawget(_G, "SP_Hub_Translator")
    if type(translator) == "function" then
        local ok, result = pcall(translator, key)
        if ok and result ~= nil then
            local translated = tostring(result)
            rememberTranslationAlias(key, translated)
            return translated
        end
    end
    rememberTranslationAlias(key, key)
    return key
end

local function isTranslatableTextObject(obj)
    return obj and typeof(obj) == "Instance"
        and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox"))
end

local function isAnimatedTextProperty(obj, property)
    return property == "Text" and isTranslatableTextObject(obj)
end

local function getTextPropertyValue(obj, property)
    if not (obj and typeof(obj) == "Instance") then return "" end
    property = property or "Text"
    local ok, value = pcall(function() return obj[property] end)
    if ok and value ~= nil then return tostring(value) end
    return ""
end

local function setTextPropertyValue(obj, property, value)
    if not (obj and typeof(obj) == "Instance") then return end
    property = property or "Text"
    pcall(function() obj[property] = tostring(value or "") end)
end

splib.TranslationAnimation = splib.TranslationAnimation or {
    Enabled = true, Mode = "Build", Duration = 0.34, FadeOutTime = 0.08,
    Stagger = 0.010, MaxDelay = 0.24, BuildSteps = 12,
    MinStepWait = 0.010, MaxStepWait = 0.035, TextFadeAmount = 0.62
}

function splib:SetTranslationAnimation(config)
    if type(config) ~= "table" then return end
