end

local function getDirectChildOfClass(parent, className)
    if not parent or typeof(parent) ~= "Instance" then return nil end
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA(className) then return child end
    end
    return nil
end

local function clearLayoutConnections(container)
    local list = LayoutModeConnections[container]
    if not list then return end
    for _, connection in ipairs(list) do
        pcall(function()
            if connection and connection.Connected then connection:Disconnect() end
        end)
    end
    LayoutModeConnections[container] = nil
end

local function bindLayoutConnection(container, connection)
    if not container or not connection then return end
    LayoutModeConnections[container] = LayoutModeConnections[container] or {}
    table.insert(LayoutModeConnections[container], connection)
    trackRuntimeConnection(connection)
end

local function reserveLayoutOrder(container)
    if not container or typeof(container) ~= "Instance" then return 0 end
    local count = 0
    pcall(function()
        count = tonumber(container:GetAttribute("SPLayoutItemCount")) or 0
        count = count + 1
        container:SetAttribute("SPLayoutItemCount", count)
    end)
    return count
end

local function getLayoutOrder(item)
    local order = nil
    pcall(function() order = tonumber(item:GetAttribute("SPLayoutOrder")) end)
    if order == nil and item and item:IsA("GuiObject") then order = tonumber(item.LayoutOrder) end
    return order or 0
end

local function markLayoutItem(item, kind, order, name)
    if not item or typeof(item) ~= "Instance" then return end
    pcall(function()
        item:SetAttribute("SPLayoutManaged", true)
        item:SetAttribute("SPLayoutKind", kind)
        item:SetAttribute("SPLayoutOrder", order or getLayoutOrder(item))
        if name ~= nil then item:SetAttribute("SPSectionName", tostring(name)) end
    end)
end

local function collectManagedLayoutItems(container)
    local items = {}
    local seen = {}
    local function add(item)
        if not item or seen[item] or not item:IsA("GuiObject") then return end
        local managed = false
        pcall(function() managed = item:GetAttribute("SPLayoutManaged") == true end)
        if managed then seen[item] = true; table.insert(items, item) end
    end
    if container and typeof(container) == "Instance" then
        for _, child in ipairs(container:GetChildren()) do
            add(child)
            if child.Name == "ColumnsFrame" then
                for _, desc in ipairs(child:GetDescendants()) do add(desc) end
            end
        end
    end
    table.sort(items, function(a, b)
        local ao = getLayoutOrder(a); local bo = getLayoutOrder(b)
        if ao == bo then return a.LayoutOrder < b.LayoutOrder end
        return ao < bo
    end)
    return items
end

local function collectManagedSections(container)
    local sections = {}
    for _, item in ipairs(collectManagedLayoutItems(container)) do
        local kind = nil
        pcall(function() kind = item:GetAttribute("SPLayoutKind") end)
        if kind == "Section" then table.insert(sections, item) end
    end
    return sections
end

local function getGridColumnGap(container)
