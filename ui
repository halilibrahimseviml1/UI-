local function configureSectionForGrid(sectionFrame)
    if not sectionFrame then return end
    local sectionName = sectionFrame:GetAttribute("SPSectionName") or sectionFrame.Name or "Section"
    sectionFrame.Name = tostring(sectionName) .. "_SectionCard"
    sectionFrame.Size = UDim2.new(1, 0, 0, 0)
    sectionFrame.AutomaticSize = Enum.AutomaticSize.Y
    sectionFrame.BackgroundTransparency = 0
    sectionFrame.BackgroundColor3 = Theme["Color Hub 2"] or Color3.fromRGB(30, 30, 30)
    sectionFrame.BorderSizePixel = 0
    sectionFrame:SetAttribute("ElementCount", 0)
    if not getDirectChildOfClass(sectionFrame, "UICorner") then
        Make("Corner", sectionFrame, UDim.new(0, 8))
    end
    local stroke = getDirectChildOfClass(sectionFrame, "UIStroke")
    if not stroke then
        stroke = Make("Stroke", sectionFrame, {
            Color = Theme["Color Stroke"] or Color3.fromRGB(15, 15, 15),
            Thickness = 1, ApplyStrokeMode = "Border"
        })
    end
    pcall(function() stroke.Enabled = true; stroke.Transparency = 0 end)
    local listLayout = getDirectChildOfClass(sectionFrame, "UIListLayout")
    if not listLayout then listLayout = Create("UIListLayout", sectionFrame) end
    listLayout.Name = "SPSectionLayout"
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 6)
    local padding = getDirectChildOfClass(sectionFrame, "UIPadding")
    if not padding then padding = Create("UIPadding", sectionFrame) end
    padding.PaddingTop = UDim.new(0, 8)
    padding.PaddingBottom = UDim.new(0, 8)
    padding.PaddingLeft = UDim.new(0, 10)
    padding.PaddingRight = UDim.new(0, 10)
    local sectionLabel = getDirectChildOfClass(sectionFrame, "TextLabel")
    if sectionLabel then
        sectionLabel.Name = "SectionTitle"
        sectionLabel.Size = UDim2.new(1, 0, 0, 20)
        sectionLabel.Position = UDim2.new(0, 0, 0, 0)
        sectionLabel.AutomaticSize = Enum.AutomaticSize.None
        sectionLabel.TextSize = isMobile and 10 or 12
        sectionLabel.TextXAlignment = Enum.TextXAlignment.Left
        sectionLabel.TextYAlignment = Enum.TextYAlignment.Center
        sectionLabel.TextTruncate = Enum.TextTruncate.AtEnd
        sectionLabel.LayoutOrder = 0
    end
    local separator = sectionFrame:FindFirstChild("Separator")
    if not separator then
        separator = InsertTheme(Create("Frame", sectionFrame, {
            Name = "Separator",
            BorderSizePixel = 0,
            BackgroundColor3 = Theme["Color Stroke"] or Color3.fromRGB(15, 15, 15)
        }), "Stroke")
    end
    separator.Visible = true
    separator.Size = UDim2.new(1, 0, 0, 1)
    separator.LayoutOrder = 1

    local function refreshSectionGridDensity()
        if not sectionFrame or not sectionFrame.Parent or sectionFrame.AutomaticSize ~= Enum.AutomaticSize.Y then return end
        local compact = isGridCardCompact(sectionFrame)
        local currentLayout = getDirectChildOfClass(sectionFrame, "UIListLayout")
        local currentPadding = getDirectChildOfClass(sectionFrame, "UIPadding")
        local currentTitle = getDirectChildOfClass(sectionFrame, "TextLabel")
        if currentLayout then currentLayout.Padding = UDim.new(0, compact and 4 or 5) end
        if currentPadding then
            local sidePadding = compact and 5 or 8
            currentPadding.PaddingTop = UDim.new(0, compact and 6 or 8)
            currentPadding.PaddingBottom = UDim.new(0, compact and 6 or 8)
            currentPadding.PaddingLeft = UDim.new(0, sidePadding)
            currentPadding.PaddingRight = UDim.new(0, sidePadding)
        end
        if currentTitle then
            currentTitle.TextSize = compact and (isMobile and 9 or 11) or (isMobile and 10 or 12)
        end
    end
    refreshSectionGridDensity()
    if sectionFrame:GetAttribute("SPGridDensityBound") ~= true then
        sectionFrame:SetAttribute("SPGridDensityBound", true)
        trackRuntimeConnection(sectionFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshSectionGridDensity))
    end
end

local function getPaddingOffset(padding, axis)
    if not padding or not padding:IsA("UIPadding") then return 0 end
    local total = 0
    pcall(function()
        if axis == "Y" then total = padding.PaddingTop.Offset + padding.PaddingBottom.Offset
        else total = padding.PaddingLeft.Offset + padding.PaddingRight.Offset end
    end)
    return total
end

local function getListPaddingOffset(listLayout)
    if not listLayout or not listLayout:IsA("UIListLayout") then return 0 end
    local value = 0
    pcall(function() value = listLayout.Padding.Offset end)
    return value
end

local function estimateGridSectionHeight(sectionFrame)
    if not sectionFrame or not sectionFrame:IsA("GuiObject") then return 0 end
    local measured = 0
    pcall(function() measured = sectionFrame.AbsoluteSize.Y end)
    if measured and measured > 8 then return measured end
    local listLayout = getDirectChildOfClass(sectionFrame, "UIListLayout")
    local padding = getDirectChildOfClass(sectionFrame, "UIPadding")
    pcall(function()
        if listLayout then measured = math.max(measured, listLayout.AbsoluteContentSize.Y + getPaddingOffset(padding, "Y")) end
    end)
    if measured and measured > 8 then return measured end
    local children = {}
    for _, child in ipairs(sectionFrame:GetChildren()) do
        if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UICorner") and not child:IsA("UIStroke") then
            table.insert(children, child)
        end
    end
    table.sort(children, function(a, b)
        if a.LayoutOrder == b.LayoutOrder then return a.Name < b.Name end
        return a.LayoutOrder < b.LayoutOrder
    end)
    local spacing = getListPaddingOffset(listLayout)
    local total = getPaddingOffset(padding, "Y")
    local visibleCount = 0
    for _, child in ipairs(children) do
        if child.Visible ~= false then
            visibleCount += 1
            local childHeight = 0
            pcall(function() childHeight = math.max(child.AbsoluteSize.Y, child.Size.Y.Offset) end)
            if childHeight <= 0 then childHeight = 28 end
            total += childHeight
        end
    end
    if visibleCount > 1 then total += spacing * (visibleCount - 1) end
    return math.max(total, 48)
end

local function distributeGridSections(container, leftColumn, rightColumn)
    if not container or not leftColumn or not rightColumn then return nil end
    local sections = collectManagedSections(container)
    local lastSection = nil
    local leftHeight = 0; local rightHeight = 0
    local leftCount = 0; local rightCount = 0
    local leftLayout = getDirectChildOfClass(leftColumn, "UIListLayout")
    local rightLayout = getDirectChildOfClass(rightColumn, "UIListLayout")
    local leftGap = getListPaddingOffset(leftLayout)
    local rightGap = getListPaddingOffset(rightLayout)
    rightColumn.Visible = true
    for index, section in ipairs(sections) do
        local sectionHeight = estimateGridSectionHeight(section)
        local targetColumn
        if index == 1 then targetColumn = leftColumn
        elseif leftCount == 0 then targetColumn = leftColumn
        elseif rightCount == 0 then targetColumn = rightColumn
        elseif leftHeight <= rightHeight then targetColumn = leftColumn
        else targetColumn = rightColumn end
        if section.Parent ~= targetColumn then section.Parent = targetColumn end
        if section.LayoutOrder ~= index then section.LayoutOrder = index end
        lastSection = section
        if targetColumn == leftColumn then
            if leftCount > 0 then leftHeight += leftGap end
            leftHeight += sectionHeight; leftCount += 1
        else
            if rightCount > 0 then rightHeight += rightGap end
            rightHeight += sectionHeight; rightCount += 1
        end
    end
    setCurrentGridCard(container, lastSection)
    container:SetAttribute("SectionCount", #sections)
    container:SetAttribute("SPGridLeftHeightEstimate", math.floor(leftHeight + 0.5))
    container:SetAttribute("SPGridRightHeightEstimate", math.floor(rightHeight + 0.5))
    return false
end

local function ensureGridColumns(container)
    if not container or typeof(container) ~= "Instance" then return nil end
    local columnsFrame = container:FindFirstChild("ColumnsFrame")
    if not columnsFrame then
        columnsFrame = Create("Frame", container, {
            Name = "ColumnsFrame", Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1, LayoutOrder = 1
        })
    end
    local columnsLayout = getDirectChildOfClass(columnsFrame, "UIListLayout")
    if not columnsLayout then columnsLayout = Create("UIListLayout", columnsFrame) end
    columnsLayout.Name = "ColumnsLayout"
    columnsLayout.Padding = UDim.new(0, GRID_COLUMN_GAP)
    columnsLayout.FillDirection = Enum.FillDirection.Horizontal
    columnsLayout.SortOrder = Enum.SortOrder.LayoutOrder
    local leftColumn = columnsFrame:FindFirstChild("LeftColumn")
    if not leftColumn then
        leftColumn = Create("Frame", columnsFrame, { Name = "LeftColumn", BackgroundTransparency = 1, LayoutOrder = 1 })
    end
    local leftLayout = getDirectChildOfClass(leftColumn, "UIListLayout")
    if not leftLayout then leftLayout = Create("UIListLayout", leftColumn) end
    leftLayout.Name = "LeftLayout"
    leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
    leftLayout.Padding = UDim.new(0, 6)
    local rightColumn = columnsFrame:FindFirstChild("RightColumn")
    if not rightColumn then
        rightColumn = Create("Frame", columnsFrame, { Name = "RightColumn", BackgroundTransparency = 1, LayoutOrder = 2 })
    end
    local rightLayout = getDirectChildOfClass(rightColumn, "UIListLayout")
    if not rightLayout then rightLayout = Create("UIListLayout", rightColumn) end
    rightLayout.Name = "RightLayout"
    rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
    rightLayout.Padding = UDim.new(0, 6)
    local function updateColumnSizes()
        local gap = getGridColumnGap(container)
        columnsLayout.Padding = UDim.new(0, gap)
        rightColumn.Visible = true
        leftColumn.Size = UDim2.new(0.5, -math.ceil(gap * 0.5), 0, leftLayout.AbsoluteContentSize.Y)
        rightColumn.Size = UDim2.new(0.5, -math.floor(gap * 0.5), 0, rightLayout.AbsoluteContentSize.Y)
        columnsFrame.Size = UDim2.new(1, 0, 0, math.max(leftLayout.AbsoluteContentSize.Y, rightLayout.AbsoluteContentSize.Y))
    end
    local isRefreshingGrid = false
    local function refreshGrid()
        if isRefreshingGrid then return end
        if not columnsFrame.Parent then return end
        isRefreshingGrid = true
        distributeGridSections(container, leftColumn, rightColumn)
        updateColumnSizes()
        task.defer(function() pcall(updateColumnSizes); isRefreshingGrid = false end)
    end
    clearLayoutConnections(container)
    bindLayoutConnection(container, leftLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshGrid))
    bindLayoutConnection(container, rightLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshGrid))
    bindLayoutConnection(container, container:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshGrid))
    refreshGrid()
    return columnsFrame, leftColumn, rightColumn
end

local function animateGridBuild(container)
    if not isPC or not container or typeof(container) ~= "Instance" then return end
    local items = collectManagedLayoutItems(container)
    local visibleIndex = 0
    for _, item in ipairs(items) do
        if item and item:IsA("GuiObject") and item.Parent and item.Visible ~= false then
            visibleIndex += 1
            local originalTransparency = item.BackgroundTransparency
            local scaleObj = item:FindFirstChild("SPGridBuildScale")
            if not scaleObj then scaleObj = Create("UIScale", item, { Name = "SPGridBuildScale", Scale = 1 }) end
            local delayTime = math.min((visibleIndex - 1) * 0.018, 0.18)
            pcall(function()
                scaleObj.Scale = 0.965
                item.BackgroundTransparency = math.clamp(originalTransparency + 0.28, 0, 1)
            end)
            task.delay(delayTime, function()
                if not item or not item.Parent then return end
                pcall(function()
                    TweenService:Create(scaleObj, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
                    TweenService:Create(item, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = originalTransparency}):Play()
                end)
            end)
        end
    end
end

local function resolveElementParent(container)
    local globalOrder = reserveLayoutOrder(container)
    local actualParent = container
    local layoutOrder = globalOrder
    pcall(function()
        if container and typeof(container) == "Instance" and container:GetAttribute("SPLayoutMode") == "Grid" then
            local currentCardVal = container:FindFirstChild("CurrentSectionCardValue")
            local card = currentCardVal and currentCardVal.Value
            if card and typeof(card) == "Instance" and card.Parent then
                actualParent = card
                local count = tonumber(card:GetAttribute("ElementCount")) or 0
                count = count + 1
                card:SetAttribute("ElementCount", count)
                layoutOrder = count + 2
            end
        end
    end)
    return actualParent, layoutOrder, globalOrder
end

local function applyLayoutModeToContainer(container, mode)
    if not container or typeof(container) ~= "Instance" then return end
    mode = normalizeLayoutMode(mode)
    local previousMode = normalizeLayoutMode(container:GetAttribute("SPLayoutMode") or splib.Save.LayoutMode or "Classic")
    local items = collectManagedLayoutItems(container)
    container:SetAttribute("SPLayoutMode", mode)
    if mode == "Grid" then
        local columnsFrame, leftColumn, rightColumn = ensureGridColumns(container)
        local currentSection = nil
        for _, item in ipairs(items) do
            local kind = item:GetAttribute("SPLayoutKind")
            if kind == "Section" then
                configureSectionForGrid(item)
                item.Parent = leftColumn
                currentSection = item
            else
                if currentSection and currentSection.Parent then
                    item.Parent = currentSection
                    item:SetAttribute("SPGridElement", true)
                    local count = tonumber(currentSection:GetAttribute("ElementCount")) or 0
                    count = count + 1
                    currentSection:SetAttribute("ElementCount", count)
                    item.LayoutOrder = count + 2
                else
                    item.Parent = container
                    item:SetAttribute("SPGridElement", false)
                    item.LayoutOrder = getLayoutOrder(item)
                end
            end
        end
        distributeGridSections(container, leftColumn, rightColumn)
        if columnsFrame then
            task.defer(function()
                if columnsFrame.Parent then
                    distributeGridSections(container, leftColumn, rightColumn)
                    if previousMode ~= "Grid" then animateGridBuild(container) end
                end
            end)
        elseif previousMode ~= "Grid" then
            task.defer(function() animateGridBuild(container) end)
        end
    else
        setCurrentGridCard(container, nil)
        clearLayoutConnections(container)
        for _, item in ipairs(items) do
            local kind = item:GetAttribute("SPLayoutKind")
            item.Parent = container
            item:SetAttribute("SPGridElement", false)
            item.LayoutOrder = getLayoutOrder(item)
            if kind == "Section" then configureSectionForClassic(item) end
        end
        local columnsFrame = container:FindFirstChild("ColumnsFrame")
        if columnsFrame then columnsFrame:Destroy() end
        container:SetAttribute("SectionCount", 0)
        if previousMode == "Grid" then
            task.defer(function() animateGridBuild(container) end)
        end
    end
end

local function applyLayoutModeToAllTabs(mode)
    mode = normalizeLayoutMode(mode)
    for _, tabInfo in ipairs(splib.Tabs) do
        local container = tabInfo and tabInfo.Cont
        if container and container.Name ~= "SettingsTab" then
            applyLayoutModeToContainer(container, mode)
        end
    end
end

