local function resetBindBoxAnimations(waitTime)
    BindBoxAnimationToken += 1
    local token = BindBoxAnimationToken
    BindBoxAnimationsReady = false
    task.defer(function()
        task.wait(tonumber(waitTime) or 0.85)
        if token == BindBoxAnimationToken then
            for bindBox, refresher in pairs(BindBoxRefreshers) do
                if bindBox and bindBox.Parent and type(refresher) == "function" then
                    pcall(refresher, false, true)
                end
            end
