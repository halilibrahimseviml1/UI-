local function applyFontSettings()
    local selected = splib.Save.SelectedFont or "Default"
    local isArabicFont = selected:find("Arabic") ~= nil
    local arabicBaseOffset = isArabicFont and 1 or 0
    local sizeOffset = splib.Save.FontSizeOffset or 0
    if fontGuiConnection then
        pcall(function() fontGuiConnection:Disconnect() end)
        fontGuiConnection = nil
    end
    if not ScreenGui then return end
    local fontObj = fontMap[selected]
    if not fontObj then return end
    for _, descendant in ipairs(ScreenGui:GetDescendants()) do
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
            if fontObj == "Default" then
                local orig = originalFonts[descendant]
                if orig then pcall(function() descendant.FontFace = orig end) end
            else
                if not originalFonts[descendant] then originalFonts[descendant] = descendant.FontFace end
                pcall(function() descendant.FontFace = fontObj end)
            end
            if not originalTextSizes[descendant] then originalTextSizes[descendant] = descendant.TextSize end
            if fontObj == "Default" and sizeOffset == 0 then
                local origSize = originalTextSizes[descendant]
                if origSize then pcall(function() descendant.TextSize = origSize end) end
            else
                local baseSize = originalTextSizes[descendant] or descendant.TextSize
                local currentOffset = sizeOffset
                if isArabicFont and shouldScaleFontSize(descendant) then
                    currentOffset = currentOffset + arabicBaseOffset
                end
                pcall(function() descendant.TextSize = math.clamp(baseSize + currentOffset, 7, 26) end)
            end
            if fontObj == "Default" then
                local origLineHeight = originalLineHeights[descendant]
                if origLineHeight then pcall(function() descendant.LineHeight = origLineHeight end) end
            else
                if not originalLineHeights[descendant] then originalLineHeights[descendant] = descendant.LineHeight end
                if isArabicFont and isMultiLineLabel(descendant) then
                    pcall(function() descendant.LineHeight = 1.35 end)
                else
                    local origLineHeight = originalLineHeights[descendant]
                    if origLineHeight then pcall(function() descendant.LineHeight = origLineHeight end) end
                end
            end
        end
    end
    if fontObj ~= "Default" or sizeOffset ~= 0 then
        fontGuiConnection = ScreenGui.DescendantAdded:Connect(function(descendant)
            task.wait()
            local current = splib.Save.SelectedFont or "Default"
            local currentFontObj = fontMap[current]
            local currentIsArabic = current:find("Arabic") ~= nil
            local currentArabicBaseOffset = currentIsArabic and 1 or 0
            local currentSizeOffset = splib.Save.FontSizeOffset or 0
            if (descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox")) then
                if not originalFonts[descendant] then originalFonts[descendant] = descendant.FontFace end
                if not originalTextSizes[descendant] then originalTextSizes[descendant] = descendant.TextSize end
                if not originalLineHeights[descendant] then originalLineHeights[descendant] = descendant.LineHeight end
                if currentFontObj and currentFontObj ~= "Default" then
                    pcall(function() descendant.FontFace = currentFontObj end)
                end
                local baseSize = originalTextSizes[descendant] or descendant.TextSize
                local currentOffset = currentSizeOffset
                if currentIsArabic and shouldScaleFontSize(descendant) then
                    currentOffset = currentOffset + currentArabicBaseOffset
                end
                pcall(function() descendant.TextSize = math.clamp(baseSize + currentOffset, 7, 26) end)
                if currentIsArabic and isMultiLineLabel(descendant) then
                    pcall(function() descendant.LineHeight = 1.35 end)
                else
                    local origLineHeight = originalLineHeights[descendant]
                    if origLineHeight then pcall(function() descendant.LineHeight = origLineHeight end) end
                end
            end
        end)
        trackRuntimeConnection(fontGuiConnection)
    end
end

